# Copie ce fichier vers .env et renseigne les valeurs.
# Le .env ne doit JAMAIS etre commite (voir .gitignore).

# Chaine de connexion MongoDB Atlas
DB_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/comparetech

# Cle protegeant les routes POST/PUT/DELETE.
# Genere-la avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sans cette variable, les routes d'ecriture renvoient 503 (fail-safe).
ADMIN_KEY=

# Cle Google AI Studio pour la route /api/ai/verdict (facultatif).
# Si absente, la route renvoie 503 et le reste de l'API fonctionne normalement.
GEMINI_API_KEY=

# Origines autorisees par CORS, separees par des virgules.
# En developpement, localhost:5173 et localhost:4173 sont ajoutes automatiquement.
CORS_ORIGINS=https://compare-tech-frontend.vercel.app

# Passer a "production" en deploiement : masque les details d'erreur
# et desactive les origines localhost par defaut.
NODE_ENV=development

# Port d'ecoute (Render le fournit automatiquement)
PORT=3001
